# Maintainer: sveinbjorn <claude@sveinbjorn.dev>
# In-tree package for the private git.s8n.is/sveinbjorn/stash fork.
# Builds from the repository this PKGBUILD lives in, not from upstream.
pkgname=stash
pkgver=r26.g8f325c2
pkgrel=1
pkgdesc="Locally hosted web-based app written in Go which organizes and serves your media library (sveinbjorn/stash fork)"
arch=('x86_64')
url="https://git.s8n.is/sveinbjorn/stash"
license=('AGPL-3.0-only')
depends=('glibc' 'ffmpeg')
makedepends=('go' 'nodejs' 'pnpm' 'git' 'make')
optdepends=(
    'nvidia-utils: NVENC/NVDEC hardware video transcoding'
    'intel-media-driver: Intel QSV/VAAPI hardware video transcoding'
    'libva-utils: VA-API debugging utilities'
    'intel-compute-runtime: OpenCL for Intel iGPU acceleration'
    'vapoursynth: advanced frame-accurate video processing'
)
conflicts=('stash-bin')
backup=("etc/conf.d/${pkgname}")
source=("${pkgname}::git+file://${startdir}/../.."
"stash.service"
"stash-user.service"
"stash.sysusers"
"stash.tmpfiles"
"stash.env"
)
sha256sums=('SKIP'
            '7fc94a87db1e9a379a0d68e165ab0a0f930a8417bb78ff408c1c7995b947b736'
            '01fd6da12c000e3c756c41cea5b85f899650a1bffdefda146563d48bba27d694'
            'de94761e4a705c6fa7216359d5286c4724c985818b21ed071d3866246fffd870'
            'd92f76d681c5c9a028340b49782dc46e8e2a3a5262b67ff3c7000f6e08e5a83e'
            '4f6add7bf6d1be8dc5df5f6117b7288a2c9d4ba97fd784bc05c197673353de85')

pkgver() {
        cd "$pkgname"
        printf 'r%s.g%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
        cd "$pkgname"
        mkdir -p build
        make pre-ui
        make generate
}

build() {
        cd "$pkgname"
        export CGO_CPPFLAGS="${CPPFLAGS}"
        export CGO_CFLAGS="${CFLAGS}"
        export CGO_CXXFLAGS="${CXXFLAGS}"
        export CGO_LDFLAGS="${LDFLAGS}"
        export GOFLAGS="-buildmode=pie -trimpath -ldflags=-linkmode=external -mod=readonly -modcacherw"
        make ui
        OUTPUT=build/ LDFLAGS= make build-release
}

package() {
        cd "$pkgname/build"
        install -Dm755 ${pkgname} "${pkgdir}/usr/bin/${pkgname}"
        cd "${srcdir}"
        install -Dm644 ${pkgname}.service "${pkgdir}/usr/lib/systemd/system/${pkgname}.service"
        install -Dm644 ${pkgname}-user.service "${pkgdir}/usr/lib/systemd/user/${pkgname}.service"
        install -Dm644 ${pkgname}.sysusers "${pkgdir}/usr/lib/sysusers.d/${pkgname}.conf"
        install -Dm644 ${pkgname}.tmpfiles "${pkgdir}/usr/lib/tmpfiles.d/${pkgname}.conf"
        install -Dm644 ${pkgname}.env "${pkgdir}/etc/conf.d/${pkgname}"
}
